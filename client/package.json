{
    "name": "teachoco-portfolio",
    "private": true,
    "version": "0.0.2",
    "type": "module",
    "scripts": {
        "dev": "tsx server.ts",
        "build:client": "vite build --outDir dist/client",
        "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
        "build:ssr": "pnpm build:client && pnpm build:server && pnpm prerender",
        "serve": "cross-env NODE_ENV=production tsx server.ts",
        "preview": "cross-env NODE_ENV=production tsx server.ts",
        "lint": "eslint .",
        "prerender": "tsx prerender.ts"
    },
    "dependencies": {
        "@pixiv/three-vrm": "^3.4.4",
        "@react-three/drei": "^10.7.7",
        "@react-three/fiber": "^9.4.2",
        "@types/three": "^0.181.0",
        "compression": "^1.8.1",
        "express": "^5.2.1",
        "framer-motion": "^12.23.25",
        "i18next": "^25.7.1",
        "i18next-browser-languagedetector": "^8.2.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-i18next": "^16.4.0",
        "react-icons": "^5.5.0",
        "react-router": "^7.10.1",
        "react-router-dom": "^7.10.1",
        "three": "^0.181.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@tailwindcss/vite": "^4.1.17",
        "@types/compression": "^1.8.1",
        "@types/express": "^5.0.6",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.5",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.1",
        "cross-env": "^10.1.0",
        "eslint": "^9.39.1",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "globals": "^16.5.0",
        "tailwindcss": "^4.1.17",
        "tsx": "^4.21.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.46.4",
        "vite": "npm:rolldown-vite@7.2.5"
    },
    "overrides": {
        "vite": "npm:rolldown-vite@7.2.5"
    }
